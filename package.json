{
  "name": "tuki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --prefix render/fotorealista --ignore-scripts --no-audit --no-fund",
    "render:build": "node render/build.mjs",
    "render:typecheck": "tsc --noEmit -p render/fotorealista/tsconfig.json",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "build": "vite build",
    "art:portada": "node art/bake_portada.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "verify:local": "node qa/verificar-local.mjs",
    "verify:changes": "node qa/verificar-cambios.mjs",
    "test:policy": "node --test qa/politica-pruebas.test.mjs",
    "publish:verified": "node qa/publicar.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
